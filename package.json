{
  "name": "playr",
  "version": "0.1.0",
  "private": true,
  "description": "Playr — aplicación para la gestión de turnos de salas de ensayo musical",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,lime \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "seed": "npm run seed -w server",
    "start": "npm run start -w server"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "concurrently": "^9.1.2",
    "sharp": "^0.35.5"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^7.6.9",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2"
  }
}
